rules_version = '2';

// ============================================================
// Deploy: Firebase Console → Firestore Database → Rules → paste this
// file's contents → Publish. (Or: `firebase deploy --only firestore:rules`
// if you're using the CLI — optional, the Console works fine on its own.)
//
// Design:
//   - users, subscriptions, notifications: owner-only. A signed-in
//     user can only ever read or write documents that belong to them.
//   - monitoring_state, changes: public READ (results.html,
//     notifications.html, and important-dates.html show this data to
//     everyone, signed in or not), but NO client write access at all —
//     only the GitHub Action can write here, because it uses the
//     Firebase Admin SDK with a service account, which bypasses these
//     rules entirely by design. That's the whole point: the monitoring
//     job is trusted server-side code, browsers are not.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /subscriptions/{subscriptionId} {
      allow read, delete, update: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.userId;
      // Notifications are only ever created by the monitoring Action
      // (Admin SDK), never directly by a client.
      allow write: if false;
    }

    match /monitoring_state/{stateId} {
      allow read: if true;
      allow write: if false;
    }

    match /changes/{changeId} {
      allow read: if true;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
